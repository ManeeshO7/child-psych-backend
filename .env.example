# Server
PORT=8000
FRONTEND_ORIGIN=http://localhost:3100

# Session (required in production)
# Use a long, random secret (at least 32+ bytes). Changing this will log everyone out.
SESSION_SECRET="change-me-to-a-long-random-secret"

# Database
DATABASE_URL="postgresql://telepsych_user:Maneesh%407@localhost:5432/telepsych?schema=public"

# Email (Resend)
RESEND_API_KEY="re_xxxxxxxx"
EMAIL_FROM="TelePsych <noreply@yourdomain.com>"
APP_URL="http://localhost:3100"

# Doctor seed
DOCTOR_EMAIL="doctor@example.com"
DOCTOR_PASSWORD="yourpassword"

# Google Calendar API (for unique Meet links per booking - required for appointment bookings)
# Create OAuth 2.0 Client ID (Web application) in Google Cloud Console.
# Add redirect URI: {FRONTEND_ORIGIN}/api/auth/google/callback (e.g. http://localhost:3100/api/auth/google/callback)
# GOOGLE_CLIENT_ID="xxx.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="xxx"

# Stripe (card on file, charge after visit)
# Get keys from https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_PUBLISHABLE_KEY="pk_test_..."  # optional; frontend uses NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY

# Visit pricing — Stripe Products per appointment type (REQUIRED for charging)
# Run: .venv/bin/python scripts/create_stripe_products.py
# This creates 4 products and prints the Price IDs. Add them here:
STRIPE_PRICE_ID_ORIENTATION_CONSULT=price_xxxxx   # 30 min orientation
STRIPE_PRICE_ID_CLINICAL_INTAKE=price_1Szt9TRvQtUu3HX9Biudrgf1    
STRIPE_PRICE_ID_FOLLOWUP_MED_30=price_1SztAlRvQtUu3HX9gqHzEfvR     
STRIPE_PRICE_ID_FOLLOWUP_MED_THERAPY_45=price_1SztBoRvQtUu3HX9pUWuJKay

# Fallback amounts (cents) if Price IDs not set—used for pricing display. Defaults shown:
# VISIT_PRICE_ORIENTATION_CONSULT_CENTS=7500    # $75
# VISIT_PRICE_CLINICAL_INTAKE_CENTS=15000       # $150
# VISIT_PRICE_FOLLOWUP_MED_30_CENTS=7500        # $75
# VISIT_PRICE_FOLLOWUP_MED_THERAPY_45_CENTS=11250  # $112.50

# Google Cloud Healthcare API (FHIR) – optional; when set, questionnaire PHI is stored in FHIR only
# Create a dataset and FHIR store in Cloud Console, then set these and GOOGLE_APPLICATION_CREDENTIALS
# GCP_PROJECT_ID="your-gcp-project"
# GCP_LOCATION="us-central1"
# GCP_DATASET_ID="your-dataset"
# GCP_FHIR_STORE_ID="your-fhir-store"
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account-key.json"

# Patient document download strategy (HIPAA-friendly default)
# false -> always use authenticated backend fallback (/api/patient-documents/{id}/download)
# true  -> prefer signed GCS URLs for patient documents
# USE_SIGNED_URLS_FOR_PATIENT_DOCS="false"
# PATIENT_DOC_SIGNED_URL_TTL_MINUTES="10"

