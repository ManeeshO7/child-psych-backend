generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
}

// JS client for Prisma Studio; run `prisma generate` with .venv activated so both clients generate
generator studio_client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String?   @map("password_hash")
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  phone          String?
  role           String    @default("patient") // "patient" | "doctor"
  patientProfile PatientProfile?
  emailVerified  DateTime? @map("email_verified")
  tempPasswordExpiresAt DateTime? @map("temp_password_expires_at")
  mustResetPassword Boolean @default(false) @map("must_reset_password")
  passwordResetToken String? @map("password_reset_token")
  passwordResetTokenExpiresAt DateTime? @map("password_reset_token_expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  patientRequest   PatientRequest?
  appointmentsAsPatient Appointment[] @relation("PatientAppointments")
  appointmentsAsDoctor   Appointment[] @relation("DoctorAppointments")
  availabilityBlocks    DoctorAvailability[]
  bookableSlots         DoctorBookableSlot[]
  googleRefreshToken    String?   @map("google_refresh_token")
  googleCalendarId     String?   @map("google_calendar_id")
  stripeCustomerId     String?   @unique @map("stripe_customer_id")
  fhirPatientId       String?   @map("fhir_patient_id") // GCP Cloud Healthcare FHIR Patient.id
  formAssignments PatientFormAssignment[] @relation("PatientFormAssignments")
  patientDocuments PatientDocument[]
  allowedFollowupTypes Json? @map("allowed_followup_types") // ["followup_med_30", "followup_med_therapy_45"] set by doctor after intake
  rejectedAfterOrientation Boolean? @map("rejected_after_orientation") // true = doctor rejected after orientation; clinical intake hidden
  @@map("users")
}

// Patient profile info required before orientation (Name, Sex, DOB, SSN, Contact, Pharmacy, Guardians)
model PatientProfile {
  id                        String   @id @default(cuid())
  userId                    String   @unique @map("user_id")
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredName             String?  @map("preferred_name")
  sex                       String?  @map("sex") // "male" | "female" | "other" | "prefer_not_to_say"
  race                      String?  @map("race")
  preferredLanguage         String?  @map("preferred_language")
  dateOfBirth               DateTime? @map("date_of_birth")
  ssn                       String?  @map("ssn") // Last 4 digits or full - consider encryption in production
  address                   String?  @db.Text
  preferredPharmacyName     String?  @map("preferred_pharmacy_name")
  preferredPharmacyPhone    String?  @map("preferred_pharmacy_phone")
  preferredPharmacyAddress  String?  @map("preferred_pharmacy_address") @db.Text
  guardian1Name             String?  @map("guardian_1_name")
  guardian1Relationship     String?  @map("guardian_1_relationship")
  guardian1Phone            String?  @map("guardian_1_phone")
  guardian1Email            String?  @map("guardian_1_email")
  guardian1Address          String?  @map("guardian_1_address") @db.Text
  guardian2Name             String?  @map("guardian_2_name")
  guardian2Relationship     String?  @map("guardian_2_relationship")
  guardian2Phone            String?  @map("guardian_2_phone")
  guardian2Email            String?  @map("guardian_2_email")
  guardian2Address          String?  @map("guardian_2_address") @db.Text
  completedAt               DateTime? @map("completed_at")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")
  @@map("patient_profiles")
}

// Patient-uploaded documents (e.g. previous medical records) stored in GCS
model PatientDocument {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String   @map("display_name") // e.g. "Previous medical records"
  fileName    String   @map("file_name")    // Original filename
  gcsPath     String   @map("gcs_path")     // Path in GCS bucket
  contentType String   @default("application/pdf") @map("content_type")
  createdAt   DateTime @default(now()) @map("created_at")
  @@map("patient_documents")
}

model PatientRequest {
  id          String   @id @default(cuid())
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  email       String
  phone       String
  notes       String?  @db.Text
  status      String   @default("pending") // "pending" | "approved" | "rejected"
  rejectedNote String? @map("rejected_note") @db.Text
  reviewedAt  DateTime? @map("reviewed_at")
  reviewedBy  String?  @map("reviewed_by")
  consentAt  DateTime? @map("consent_at")
  questionnaireData Json? @map("questionnaire_data")
  fhirQuestionnaireResponseId String? @map("fhir_questionnaire_response_id")
  createdAt   DateTime @default(now()) @map("created_at")

  userId String? @unique @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@map("patient_requests")
}

model DoctorAvailability {
  id                     String    @id @default(cuid())
  doctorId               String    @map("doctor_id")
  doctor                 User      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  date                   DateTime  @db.Date
  startTime              String    @map("start_time") // "09:00" (HH:MM, practice timezone)
  endTime                String    @map("end_time")   // "12:00"
  allowedDurationsMinutes Json?    @map("allowed_durations_minutes") // e.g. [30, 45, 60]; null = all
  createdAt              DateTime  @default(now()) @map("created_at")
  @@map("doctor_availability")
}

// Slots the doctor has explicitly offered for booking (per duration). Patients only see these.
model DoctorBookableSlot {
  id               String   @id @default(cuid())
  doctorId         String   @map("doctor_id")
  doctor           User     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  date             DateTime @db.Date
  startTime        String   @map("start_time") // "09:00" (HH:MM, practice TZ)
  durationMinutes  Int      @map("duration_minutes") // 30, 45, or 60
  createdAt        DateTime @default(now()) @map("created_at")
  @@unique([doctorId, date, startTime, durationMinutes])
  @@map("doctor_bookable_slots")
}

model Appointment {
  id              String   @id @default(cuid())
  patientId       String   @map("patient_id")
  patient         User     @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  doctorId        String   @map("doctor_id")
  doctor          User     @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: Cascade)
  scheduledAt     DateTime @map("scheduled_at")
  durationMinutes Int     @default(60) @map("duration_minutes")
  status         String   @default("scheduled") // "scheduled" | "card_on_file" | "paid" | "completed" | "cancelled" | "pending_confirmation"
  type           String   @default("followup") // orientation_consult | clinical_intake | followup_med_30 | followup_med_therapy_45 | intake | followup | post_intake (legacy)
  notes          String?  @db.Text
  meetLink       String?  @map("meet_link")
  googleCalendarEventId String? @map("google_calendar_event_id") // For update/delete on reschedule or cancel
  fhirEncounterId String? @map("fhir_encounter_id") // FHIR Encounter for HIPAA-compliant encounter notes
  requireFormsBeforeConfirm Boolean @default(true) @map("require_forms_before_confirm") // If true, patient must complete assigned forms before confirming
  patientRescheduleCount    Int     @default(0) @map("patient_reschedule_count") // Patient can reschedule only once; doctor reschedules do not increment
  chargedAt      DateTime? @map("charged_at") // Set when payment is successfully collected
  amountCents    Int?      @map("amount_cents") // Amount charged in cents
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  
  formAssignments PatientFormAssignment[]
  @@map("appointments")
}

// Master list of all available forms (questionnaires + PDF templates)
model Form {
  id              String   @id @default(cuid())
  title           String
  description     String?  @db.Text
  type            String   // "questionnaire" | "pdf_upload"
  questionnaireKey String? @map("questionnaire_key") // For questionnaires: which form definition to render
  templateGcsPath String?  @map("template_gcs_path") // For PDFs: "forms/templates/Clinical_Workflow_Blueprint.pdf"
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  
  assignments     PatientFormAssignment[]
  @@map("forms")
}

// Which forms are assigned to which patient (after intake appointment)
model PatientFormAssignment {
  id              String   @id @default(cuid())
  patientId       String   @map("patient_id")
  patient         User     @relation("PatientFormAssignments", fields: [patientId], references: [id], onDelete: Cascade)
  formId          String   @map("form_id")
  form            Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  appointmentId   String?  @map("appointment_id") // Intake appointment that triggered this
  appointment     Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  assignedBy      String   @map("assigned_by") // Doctor user ID
  assignedAt      DateTime @default(now()) @map("assigned_at")
  status          String   @default("pending") // "pending" | "completed"
  completedAt     DateTime? @map("completed_at")
  
  // For questionnaires: FHIR QuestionnaireResponse ID
  fhirResponseId String?  @map("fhir_response_id")
  
  // For PDF uploads: GCS path to uploaded file
  uploadedGcsPath String?  @map("uploaded_gcs_path") // e.g. "patient-docs/patient-{id}/forms/{assignmentId}.pdf"
  
  submission      FormSubmission?
  @@map("patient_form_assignments")
}

// Track submission metadata
model FormSubmission {
  id            String   @id @default(cuid())
  assignmentId String   @unique @map("assignment_id")
  assignment    PatientFormAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  submittedAt   DateTime @default(now()) @map("submitted_at")
  notes         String?  @db.Text // Optional patient notes
  @@map("form_submissions")
}
